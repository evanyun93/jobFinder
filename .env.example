# 텔레그램 @BotFather 에서 /newbot 으로 발급
TELEGRAM_BOT_TOKEN=

# 워크넷 오픈API 인증키 (UUID 형식)
# 발급: https://openapi.work.go.kr  →  '채용정보' 활용신청
# 주의: 공공데이터포털(data.go.kr) 의 serviceKey 와는 다른 값입니다.
#       이 어댑터는 openapi.work.go.kr 엔드포인트를 쓰므로 UUID 형식 authKey 가 필요합니다.
WORKNET_AUTH_KEY=
WORKNET_ENABLED=true

# 사람인 오픈API access-key (https://oapi.saramin.co.kr/join, 신청→승인, 일 500회)
SARAMIN_ACCESS_KEY=
SARAMIN_ENABLED=false

# 잡코리아 채용정보 API
# 신청: https://www.jobkorea.co.kr/service/api (문의 api@jobkorea.co.kr)
# 공공기관/학교 대상 서비스라 개인은 내부 검토 후 제공 여부가 결정됩니다.
# 승인되면 IP 등록 후 "고유 호출 링크"를 가이드와 함께 받는데, 그 URL 을 통째로 넣으세요.
# (다른 소스와 달리 키가 아니라 URL 입니다. 조건·페이징이 URL 안에 이미 들어 있습니다.)
# 받은 가이드의 지역 코드표는 app/sources/jobkorea.py 의 AREA_CODES 에 채워야 합니다.
JOBKOREA_API_URL=
JOBKOREA_ENABLED=false

# Greenhouse 공개 채용보드. 키도 승인도 필요 없어 기본으로 켜져 있습니다.
# 보드 토큰은 기업 채용페이지 URL(boards.greenhouse.io/<토큰>)에 그대로 있습니다.
GREENHOUSE_BOARDS=krafton,moloco,sendbird,daangn
GREENHOUSE_ENABLED=true

# ---- Supabase Postgres ----
# 대시보드 > Project Settings > Database > Connection string
# 반드시 [Transaction pooler] 탭(포트 6543)을 쓰세요. 서버리스는 호출마다 새
# 커넥션을 열기 때문에 직접 접속(5432)으로는 금방 한도에 걸립니다.
DATABASE_URL=

# ---- 서버리스 엔드포인트 보호 ----
# Vercel 의 웹훅/크론 URL 은 공개 주소입니다. 이 값이 없으면 아무나 호출해
# 가짜 명령을 넣거나 다이제스트를 중복 발송시킬 수 있습니다.
# 로컬 .env 와 Vercel 환경변수에 '같은 값'을 넣어야 합니다.
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# 로컬 상주 모드(run)에서만 의미가 있습니다. Vercel 에서는 vercel.json 의
# crons.schedule 이 발송 시각을 정합니다 (UTC 기준!).
DIGEST_HOUR=8
DIGEST_MINUTE=0
TZ_NAME=Asia/Seoul

# 지역을 서울·판교권으로 좁혔으므로 넉넉히 훑는다.
# 로그의 "대상지역 N건 (M%)" 을 보고 조정할 것.
INGEST_MAX_PAGES=30

# 배포 주소 (예: https://myapp.vercel.app).
# `python -m app.main webhook on` 이 이 값으로 웹훅을 겁니다.
PUBLIC_BASE_URL=
